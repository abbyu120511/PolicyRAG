# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and machine-specific state
.env
.env.*
!.env.example
.qwen_ip_cache
.DS_Store

# Private source documents. Keep real insurance documents on this machine only.
private_docs/*
