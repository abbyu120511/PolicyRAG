# Local artifacts generated from private documents (OCR output, vector stores, etc.)
storage/*
!storage/.gitkeep

# Legacy local document and vector-store locations used by the early exercises
pdf/
ragapp/docs/
ragapp/chroma_db/

# Local resume-generation artifacts; not part of the PolicyRAG repository
output/
tmp/
